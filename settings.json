{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "EDITOR": "code",
    "CLAUDE_SOUND": "1",
    "CLAUDE_SOUND_STOP_NAME": "Glass",
    "CLAUDE_SOUND_NOTIFY_NAME": "Ping"
  },
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(chezmoi *)",
      "Bash(cargo *)",
      "Bash(go *)",
      "Bash(uv *)",
      "Bash(cat *)",
      "Bash(ls *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(which *)",
      "Bash(echo *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(rm *)",
      "Bash(touch *)",
      "Bash(chmod +x *)",
      "Bash(zip *)",
      "Bash(unzip *)",
      "Bash(ps *)",
      "Bash(bash -n *)",
      "Bash(shellcheck *)",
      "Bash(pwd)",
      "Bash(cd *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(pip *)",
      "Bash(devbox *)",
      "Bash(proto *)",
      "Bash(volta *)",
      "Bash(bun *)",
      "Bash(deno *)",
      "Bash(docker *)",
      "Bash(lefthook *)",
      "Bash(make *)",
      "Bash(jq *)",
      "Bash(wc *)",
      "Bash(sort *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(find *)",
      "Bash(sed *)",
      "Bash(awk *)",
      "Bash(diff *)",
      "Bash(tree *)",
      "Bash(realpath *)",
      "Bash(dirname *)",
      "Bash(basename *)",
      "Bash(test *)",
      "Bash(true)",
      "Bash(false)",
      "Bash(gcloud secrets versions list *)",
      "Bash(gcloud secrets list *)",
      "Bash(gcloud secrets describe *)",
      "Bash(gcloud run services describe *)",
      "Bash(gcloud run services list *)",
      "Bash(gcloud run revisions list *)",
      "Bash(gcloud run revisions describe *)",
      "Bash(gcloud logging read *)",
      "Bash(gcloud projects describe *)",
      "Bash(gcloud auth list *)",
      "Bash(gcloud config list *)",
      "Bash(gcloud config get-value *)",
      "Bash(gcloud iam service-accounts list *)",
      "Bash(gcloud iam service-accounts describe *)",
      "Read(~/.local/share/chezmoi/dot_claude/**)",
      "Write(~/.local/share/chezmoi/dot_claude/**)",
      "Edit(~/.local/share/chezmoi/dot_claude/**)",
      "Read(/**)",
      "Write(/**)",
      "Edit(/**)",
      "Glob(/**)",
      "Grep(/**)",
      "Agent",
      "WebSearch",
      "WebFetch",
      "AskUserQuestion",
      "ExitPlanMode",
      "EnterPlanMode",
      "NotebookEdit",
      "ToolSearch",
      "TaskCreate",
      "TaskGet",
      "TaskList",
      "TaskUpdate",
      "TaskStop",
      "TaskOutput",
      "CronCreate",
      "CronList",
      "CronDelete",
      "ScheduleWakeup",
      "SendMessage",
      "RemoteTrigger"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(git push --force *)",
      "Bash(git reset --hard *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "COMPOSE_DIR=\"$HOME/.claude/external/claude-code-monitoring-guide\"; [ -f \"$COMPOSE_DIR/docker-compose.yml\" ] && docker info >/dev/null 2>&1 && docker compose -f \"$COMPOSE_DIR/docker-compose.yml\" up -d",
            "timeout": 60,
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/pre-task-estimate.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/approval-sound.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/loop-detection.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/no-bash-and.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/no-pr-create.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/tdd-guard.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/play-sound.sh notify"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/stop-improvement-check.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/notify.sh 'Claude Code' '作業が完了しました。' stop"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/external/claude-statusline/bin/statusline.sh",
    "padding": 2
  },
  "language": "English",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "voiceEnabled": true
}
