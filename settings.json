{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "EDITOR": "code"
  },
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(cargo *)",
      "Bash(go *)",
      "Bash(uv *)",
      "Bash(cat *)",
      "Bash(ls *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(which *)",
      "Bash(echo *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(pwd)",
      "Bash(cd *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(pip *)",
      "Bash(devbox *)",
      "Bash(proto *)",
      "Bash(volta *)",
      "Bash(bun *)",
      "Bash(deno *)",
      "Bash(docker *)",
      "Bash(make *)",
      "Bash(jq *)",
      "Bash(wc *)",
      "Bash(sort *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(find *)",
      "Bash(sed *)",
      "Bash(awk *)",
      "Bash(diff *)",
      "Bash(tree *)",
      "Bash(realpath *)",
      "Bash(dirname *)",
      "Bash(basename *)",
      "Bash(test *)",
      "Bash(true)",
      "Bash(false)",
      "Read(/**)",
      "Write(/**)",
      "Edit(/**)",
      "Glob(/**)",
      "Grep(/**)",
      "Agent",
      "WebSearch",
      "WebFetch",
      "AskUserQuestion",
      "ExitPlanMode",
      "EnterPlanMode",
      "NotebookEdit",
      "TaskCreate",
      "TaskGet",
      "TaskList",
      "TaskUpdate",
      "TaskStop",
      "TaskOutput",
      "CronCreate",
      "CronList",
      "CronDelete"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(git push --force *)",
      "Bash(git reset --hard *)"
    ]
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.title + \"|\" + .message' | while IFS='|' read -r title message; do bash ~/.claude/scripts/notify.sh \"$title\" \"$message\"; done"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/notify.sh 'Claude Code' '作業が完了しました。'"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/external/claude-statusline/bin/statusline.sh",
    "padding": 2
  },
  "voiceEnabled": true,
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "language": "Japanese"
}
